<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }} | The Daily Drop</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for icons (Payment, Arrows) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Oswald:wght@700&family=Racing+Sans+One&display=swap" rel="stylesheet">
    
    {{ content_for_header }}

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Oswald', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            neon: '#EF4444',
                            dark: '#000000',
                            card: '#111827'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom Font FastUp per il logo */
        @font-face {
            font-family: 'FastUp';
            src: url('{{ "FastUp.woff2" | asset_url }}') format('woff2'),
                 url('{{ "FastUp.ttf" | asset_url }}') format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        .logo-font {
            /* Se FastUp non è caricato nella cartella, mostrerà Racing Sans One come anteprima */
            font-family: 'FastUp', 'Racing Sans One', sans-serif;
            font-size: 2rem !important; /* Ingrandito leggermente per dare più importanza */
        }

        /* Custom scrollbar for dark theme */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #111; }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #EF4444; }
        
        /* Smooth transitions */
        .fade-in { animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
    </style>
</head>
<body class="bg-brand-dark text-white font-sans antialiased flex flex-col min-h-screen">

    <!-- 1. STICKY HEADER & COUNTDOWN -->
    <header class="sticky top-0 z-50 bg-black/95 backdrop-blur-md border-b border-zinc-800 shadow-2xl">
        <!-- FOMO Banner -->
        <div class="bg-brand-neon text-black font-bold uppercase tracking-widest text-xs md:text-sm py-2 px-4 flex justify-center items-center gap-3">
            <i class="fa-solid fa-fire animate-pulse"></i> HERE TODAY GONE TOMORROW
            <div class="bg-black text-brand-neon px-2 py-0.5 rounded font-mono text-sm shadow-inner" id="countdown">23:59:59</div>
        </div>
        
        <!-- Navbar con Logo FastUp -->
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <div class="logo-font text-2xl md:text-3xl tracking-wider text-white">OneDayThing<span class="text-brand-neon">.com</span></div>
            <a href="#plus" class="text-sm font-semibold text-zinc-400 hover:text-white transition-colors flex items-center gap-2">
                <i class="fa-solid fa-lock text-brand-neon"></i> The Vault
            </a>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="flex-grow">
        {{ content_for_layout }}
    </main>

    <!-- 5. "PLUS" SUBSCRIPTION TEASER (FOOTER) -->
    <footer id="plus" class="bg-black text-white py-16 mt-auto border-t border-zinc-900 relative">
        <!-- Top Neon Border -->
        <div class="absolute top-0 left-0 w-full h-[2px] bg-brand-neon shadow-[0_0_15px_rgba(239,68,68,1)]"></div>
        
        <div class="container mx-auto px-4 text-center max-w-2xl">
            <i class="fa-solid fa-vault text-5xl text-zinc-700 mb-6"></i>
            <h4 class="font-display text-3xl mb-4 uppercase tracking-widest">Missed A Drop?</h4>
            <p class="text-zinc-400 mb-8 text-lg">
                Past products are locked in the Vault. Strictly reserved for <strong class="text-white">OneDayThing Plus+</strong> members.
            </p>
            <button class="bg-transparent border-2 border-zinc-700 hover:border-brand-neon hover:text-brand-neon text-white font-bold py-3 px-8 rounded-xl transition-all duration-300 uppercase tracking-wider text-sm">
                Unlock The Vault
            </button>
            
            <div class="mt-16 pt-8 border-t border-zinc-900 text-sm text-zinc-600 flex flex-col md:flex-row justify-center items-center gap-6">
                <span class="logo-font text-lg text-zinc-500">OneDayThing.com</span>
                <span>&copy; {{ 'now' | date: "%Y" }}</span>
                <a href="#" class="hover:text-white transition-colors">Terms</a>
                <a href="#" class="hover:text-white transition-colors">Privacy</a>
            </div>
        </div>
    </footer>

    <!-- JavaScript for Interactions -->
