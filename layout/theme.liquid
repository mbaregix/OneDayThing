<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Tag obbligatorio di Shopify per script e app -->
  {{ content_for_header }}

  <style>
    /* Caricamento dinamico del font dalla cartella assets di Shopify */
    @font-face {
      font-family: 'FastUp';
      src: url('{{ "Fastup-Regular.ttf" | asset_url }}') format('truetype');
      font-weight: normal;
      font-style: normal;
    }

    .logo-font { font-family: 'FastUp', sans-serif; }
    .text-brand-neon { color: #EF4444; }
    .fomo-pulse { animation: pulse 1.5s infinite; }
    @keyframes pulse {
      0% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.1); opacity: 0.7; }
      100% { transform: scale(1); opacity: 1; }
    }
  </style>
</head>
<body class="bg-black text-gray-100 font-sans">

  <!-- HEADER E NAVBAR (Puoi incollare qui il tuo header) -->
  <header class="sticky top-0 z-50 bg-black text-white shadow-lg border-b border-gray-800">
    <div class="bg-red-600 text-center py-2 px-4 flex justify-center items-center gap-3 text-sm md:text-base font-bold uppercase tracking-wider">
      <i class="fa-solid fa-fire fomo-pulse text-yellow-300"></i>
      <span>Here Today Gone Tomorrow</span>
      <div id="countdown" class="bg-black text-white px-2 py-1 rounded font-mono border border-red-500">23:59:59</div>
    </div>
    <div class="flex justify-between items-center p-4 max-w-4xl mx-auto">
      <div class="logo-font text-2xl md:text-3xl tracking-wider text-white">OneDayThing<span class="text-brand-neon">.com</span></div>
      <a href="#plus" class="text-sm font-semibold text-gray-400 hover:text-white transition-colors">
        <i class="fa-solid fa-lock mr-1"></i> The Vault
      </a>
    </div>
  </header>

  <!-- Tag obbligatorio di Shopify dove caricherà il contenuto della pagina -->
  <main role="main">
    {{ content_for_layout }}
  </main>

  <!-- FOOTER (Puoi incollare qui il tuo footer) -->
  <footer class="mt-12 py-8 border-t border-gray-800 text-center text-gray-500 text-sm">
    <p>&copy; {{ 'now' | date: "%Y" }} OneDayThing.com - All rights reserved.</p>
  </footer>

  <!-- SCRIPT DEL COUNTDOWN -->
  <script>
    function updateCountdown() {
      const now = new Date();
      const endOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
      const diff = endOfDay - now;
      const h = String(Math.floor((diff / (1000 * 60 * 60)) % 24)).padStart(2, '0');
      const m = String(Math.floor((diff / 1000 / 60) % 60)).padStart(2, '0');
      const s = String(Math.floor((diff / 1000) % 60)).padStart(2, '0');
      document.getElementById('countdown').innerText = `${h}:${m}:${s}`;
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();
  </script>
</body>
</html>
