    <!-- JavaScript for Interactions -->
    <script>
        // --- 2. CAROUSEL LOGIC ---
        // Placeholder images simulating a product view
        const images = [
            "https://placehold.co/800x600/111111/FFFFFF?text=Keyboard+Front+View",
            "https://placehold.co/800x600/222222/FFFFFF?text=Keyboard+Side+Profile",
            "https://placehold.co/800x600/0a0a0a/FFFFFF?text=Switch+Detail+Macro"
        ];
        let currentIndex = 0;
        const imgElement = document.getElementById('carouselImage');
        const dotsContainer = document.getElementById('carouselDots');

        function renderDots() {
            dotsContainer.innerHTML = '';
            images.forEach((_, index) => {
                const dot = document.createElement('div');
                dot.className = `w-2.5 h-2.5 rounded-full transition-colors duration-200 cursor-pointer ${index === currentIndex ? 'bg-white' : 'bg-white/40'}`;
                dot.onclick = () => goToImage(index);
                dotsContainer.appendChild(dot);
            });
        }

        function updateImage() {
            // Simple fade effect
            imgElement.style.opacity = 0.5;
            setTimeout(() => {
                imgElement.src = images[currentIndex];
                imgElement.style.opacity = 1;
                renderDots();
            }, 150);
        }

        function nextImage() {
            currentIndex = (currentIndex + 1) % images.length;
            updateImage();
        }

        function prevImage() {
            currentIndex = (currentIndex - 1 + images.length) % images.length;
            updateImage();
        }
        
        function goToImage(index) {
            currentIndex = index;
            updateImage();
        }

        // Initialize carousel dots
        renderDots();


        // --- 3. UI INTERACTIONS ---
        function handlePurchase() {
            const msgBox = document.getElementById('purchaseMessage');
            msgBox.innerHTML = "<i class='fa-solid fa-spinner fa-spin mr-2'></i> Processing secure checkout...";
            msgBox.classList.remove('hidden');
            msgBox.classList.add('fade-in', 'block', 'border-brand-neon', 'text-brand-neon');

            // Simulate redirect delay
            setTimeout(() => {
                msgBox.innerHTML = "<i class='fa-solid fa-check-circle mr-2'></i> Redirecting to payment gateway...";
                msgBox.classList.remove('border-brand-neon', 'text-brand-neon');
                msgBox.classList.add('border-green-500', 'text-green-500');
            }, 1000);
        }
    </script>
